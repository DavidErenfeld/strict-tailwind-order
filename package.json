{
  "name": "strict-tailwind-order",
  "version": "1.0.2",
  "description": "Prettier plugin for strict functional Tailwind CSS class ordering and family-safe line wrapping",
  "type": "module",
  "main": "index.mjs",
  "module": "index.mjs",
  "types": "index.d.mts",
  "files": [
    "index.mjs",
    "index.d.mts",
    "bin",
    "lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "prettier",
    "prettier-plugin",
    "tailwindcss",
    "vue",
    "typescript",
    "jsx",
    "formatting"
  ],
  "license": "MIT",
  "peerDependencies": {
    "prettier": "^3.7.0",
    "prettier-plugin-tailwindcss": "^0.8.0"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.18"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidErenfeld/strict-tailwind-order.git"
  },
  "homepage": "https://github.com/DavidErenfeld/strict-tailwind-order#readme",
  "bugs": {
    "url": "https://github.com/DavidErenfeld/strict-tailwind-order/issues"
  },
  "bin": {
    "strict-tailwind-order": "./bin/strict-tailwind-order.mjs"
  },
  "dependencies": {
    "fast-glob": "^3.3.3"
  },
  "peerDependenciesMeta": {
    "prettier-plugin-tailwindcss": {
      "optional": true
    }
  }
}
